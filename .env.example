LOG_LEVEL=info
# The SQLite file the viewer reads; it is in the repo. Commands run from app/.
DB_PATH=../data/mrav.sqlite
# How often the viewer asks for the monster, in milliseconds (at least 50).
REFRESH_MS=500
# Where the monster comes from: auto (whichever of DuckStation and MR2DX is running; the demo panel on a system
# that cannot read a game), demo (the panel on screen), duckstation or mr2dx (Windows only).
GAME=auto
